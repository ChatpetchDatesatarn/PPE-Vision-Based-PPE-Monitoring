# Auto-start the alert script when the Jetson boots
# Install:
#   sudo cp jetson-alert.service /etc/systemd/system/
#   (edit User and the script path below to match your machine)
#   sudo systemctl daemon-reload && sudo systemctl enable --now jetson-alert
[Unit]
Description=Safety Alert Controller (MQTT -> GPIO)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=jetson
ExecStart=/usr/bin/python3 /home/jetson/safety/jetson_alert.py --host localhost
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
