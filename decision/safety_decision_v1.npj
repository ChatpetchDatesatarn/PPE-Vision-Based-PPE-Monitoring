            "data": "{\n    \"connections\": [\n        {\n            \"in_id\": \"{fd3ec321-eb00-40a7-9b15-6261d1e5eb9b}\",\n            \"in_index\": 0,\n            \"out_id\": \"{a822739a-da67-4f50-9cad-141404225c9c}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{a1216de1-2656-4401-995b-c6dc992ca297}\",\n            \"in_index\": 0,\n            \"out_id\": \"{fd3ec321-eb00-40a7-9b15-6261d1e5eb9b}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{a822739a-da67-4f50-9cad-141404225c9c}\",\n            \"in_index\": 0,\n            \"out_id\": \"{a1216de1-2656-4401-995b-c6dc992ca297}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{ab17bc21-023f-409f-9917-0d429403d107}\",\n            \"in_index\": 0,\n            \"out_id\": \"{aa552471-f4c1-405f-93ff-d8d2647c3c84}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{6eb6afbe-b641-4484-8539-a96b217604ac}\",\n            \"in_index\": 0,\n            \"out_id\": \"{00c6c73c-fd5d-46ae-9573-9a9524d7841d}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{00c6c73c-fd5d-46ae-9573-9a9524d7841d}\",\n            \"in_index\": 0,\n            \"out_id\": \"{c645cf1d-8456-476b-bb21-f340e31c2350}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{aa552471-f4c1-405f-93ff-d8d2647c3c84}\",\n            \"in_index\": 0,\n            \"out_id\": \"{a822739a-da67-4f50-9cad-141404225c9c}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{c645cf1d-8456-476b-bb21-f340e31c2350}\",\n            \"in_index\": 0,\n            \"out_id\": \"{e272839b-6c5b-4818-9321-c666573f0214}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{e272839b-6c5b-4818-9321-c666573f0214}\",\n            \"in_index\": 0,\n            \"out_id\": \"{00c6c73c-fd5d-46ae-9573-9a9524d7841d}\",\n            \"out_index\": 0\n        }\n    ],\n    \"nodes\": [\n        {\n            \"id\": \"{aa552471-f4c1-405f-93ff-d8d2647c3c84}\",\n            \"model\": {\n                \"data\": {\n                    \"console\": \"\",\n                    \"js_code\": \"ifelse = ( payload.hasOwnProperty(\\\"event_id\\\") )\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        }\n                    }\n                },\n                \"name\": \"IfElse\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 170,\n                \"y\": 85\n            }\n        },\n        {\n            \"id\": \"{c645cf1d-8456-476b-bb21-f340e31c2350}\",\n            \"model\": {\n                \"delay_time\": 10000,\n                \"name\": \"Delay\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -323,\n                \"y\": 459\n            }\n        },\n        {\n            \"id\": \"{00c6c73c-fd5d-46ae-9573-9a9524d7841d}\",\n            \"model\": {\n                \"data\": {\n                    \"console\": \"\",\n                    \"js_code\": \"// ===== JavaScript node: heartbeat (ES5 for CiRA / QtScript), runs every 10 s via Delay -> cira/status =====\\nfunction pad2(n) { var s = String(n); return s.length < 2 ? \\\"0\\\" + s : s; }\\nfunction isoBkk(ms) {\\n  var d = new Date(ms + 7 * 3600 * 1000);          // QtScript has no Date.prototype.toISOString\\n  return d.getUTCFullYear() + \\\"-\\\" + pad2(d.getUTCMonth() + 1) + \\\"-\\\" + pad2(d.getUTCDate()) + \\\"T\\\" +\\n         pad2(d.getUTCHours()) + \\\":\\\" + pad2(d.getUTCMinutes()) + \\\":\\\" + pad2(d.getUTCSeconds()) + \\\"+07:00\\\";\\n}\\nfunction clearObject(o) { for (var k in o) if (o.hasOwnProperty(k)) delete o[k]; }\\n\\ntry {\\n  var st = null;\\n  if (hasGlobal(\\\"decide_state\\\")) st = getGlobal(\\\"decide_state\\\");\\n  if (typeof st === \\\"string\\\") { try { st = JSON.parse(st); } catch (e) { st = null; } }\\n  if (!st || typeof st !== \\\"object\\\") st = { received: 0, published: 0, filtered: 0, last_rx: \\\"\\\" };\\n  clearObject(payload);\\n  payload.online = true;\\n  payload.ts = isoBkk(Date.now());\\n  payload.flow = \\\"safety_decision_v1\\\";\\n  payload.received = st.received || 0;\\n  payload.published = st.published || 0;\\n  payload.filtered = st.filtered || 0;\\n  payload.last_rx = st.last_rx || \\\"\\\";\\n} catch (e) {\\n  print(\\\"ERROR heartbeat: \\\" + e + \\\"\\\\n\\\");\\n}\\n\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": false,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        }\n                    }\n                },\n                \"name\": \"JavaScript\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -187,\n                \"y\": 442\n            }\n        },\n        {\n            \"id\": \"{fd3ec321-eb00-40a7-9b15-6261d1e5eb9b}\",\n            \"model\": {\n                \"name\": \"AutoRun\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": true\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -391,\n                \"y\": 187\n            }\n        },\n        {\n            \"id\": \"{ab17bc21-023f-409f-9917-0d429403d107}\",\n            \"model\": {\n                \"mqtt_pub\": {\n                    \"cert_file\": \"-\",\n                    \"host\": \"127.0.0.1\",\n                    \"is_use_cert\": false,\n                    \"is_use_ssl\": false,\n                    \"pass\": \"\",\n                    \"port\": 1883,\n                    \"qos\": 1,\n                    \"send_img\": false,\n                    \"topic\": \"factory/safety/cam01/event\",\n                    \"user\": \"\"\n                },\n                \"name\": \"MqttPub\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 408,\n                \"y\": 136\n            }\n        },\n        {\n            \"id\": \"{a1216de1-2656-4401-995b-c6dc992ca297}\",\n            \"model\": {\n                \"mqtt_sub\": {\n                    \"cert_file\": \"-\",\n                    \"host\": \"127.0.0.1\",\n                    \"is_use_cert\": false,\n                    \"is_use_ssl\": false,\n                    \"pass\": \"\",\n                    \"port\": 1883,\n                    \"qos\": 1,\n                    \"topic\": \"factory/safety/+/ds/violation\",\n                    \"user\": \"\"\n                },\n                \"name\": \"MqttSub\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -221,\n                \"y\": 153\n            }\n        },\n        {\n            \"id\": \"{a822739a-da67-4f50-9cad-141404225c9c}\",\n            \"model\": {\n                \"data\": {\n                    \"console\": \"\",\n                    \"js_code\": \"// ===== JavaScript node: decide (ES5 for CiRA / QtScript) =====\\nvar CONFIG = {\\n  minConf: { no_helmet: 0.40, no_vest: 0.35, restricted_zone: 0.30, unknown_visibility: 0.30 },\\n  enabled: { no_helmet: true, no_vest: true, restricted_zone: true, unknown_visibility: false },\\n  cooldownS: 30,\\n  severity: { restricted_zone: \\\"critical\\\", no_helmet: \\\"high\\\", no_vest: \\\"warning\\\", unknown_visibility: \\\"info\\\" },\\n  code: { no_helmet: \\\"nh\\\", no_vest: \\\"nv\\\", restricted_zone: \\\"rz\\\", unknown_visibility: \\\"uv\\\" }\\n};\\nvar DEBUG = false;\\n\\nfunction pad2(n) { var s = String(n); return s.length < 2 ? \\\"0\\\" + s : s; }\\nfunction pad3(n) { var s = String(n); while (s.length < 3) s = \\\"0\\\" + s; return s; }\\n\\n// BKK (+07:00) wall-clock parts of an epoch, built by hand (QtScript has no Date.prototype.toISOString).\\nfunction bkkParts(ms) {\\n  var d = new Date(ms + 7 * 3600 * 1000);          // shift, then read UTC fields = BKK local fields\\n  return { Y: String(d.getUTCFullYear()), Mo: pad2(d.getUTCMonth() + 1), D: pad2(d.getUTCDate()),\\n           H: pad2(d.getUTCHours()), Mi: pad2(d.getUTCMinutes()), S: pad2(d.getUTCSeconds()) };\\n}\\nfunction isoBkk(ms) {\\n  var b = bkkParts(ms);\\n  return b.Y + \\\"-\\\" + b.Mo + \\\"-\\\" + b.D + \\\"T\\\" + b.H + \\\":\\\" + b.Mi + \\\":\\\" + b.S + \\\"+07:00\\\";\\n}\\nfunction stampBkk(ms) {                              // YYYYMMDD-HHMMSS for event_id, no regex\\n  var b = bkkParts(ms);\\n  return b.Y + b.Mo + b.D + \\\"-\\\" + b.H + b.Mi + b.S;\\n}\\n\\nfunction decide(v, lastSent, nowMs) {\\n  if (!v || typeof v.camera_id !== \\\"string\\\" || typeof v.type !== \\\"string\\\" ||\\n      typeof v.track_id !== \\\"number\\\" || typeof v.conf !== \\\"number\\\" ||\\n      !CONFIG.code.hasOwnProperty(v.type)) return null;\\n  if (v.conf < CONFIG.minConf[v.type]) return null;\\n  if (CONFIG.enabled[v.type] !== true) return null;\\n  var key = v.camera_id + \\\"|\\\" + v.track_id + \\\"|\\\" + v.type;\\n  if (lastSent.hasOwnProperty(key) && nowMs - lastSent[key] < CONFIG.cooldownS * 1000) return null;\\n  lastSent[key] = nowMs;\\n  return {\\n    event_id: v.camera_id + \\\"-\\\" + stampBkk(nowMs) + \\\"-\\\" + pad3(v.track_id) + \\\"-\\\" + CONFIG.code[v.type],\\n    ts: isoBkk(nowMs), camera_id: v.camera_id, zone_id: v.zone_id || \\\"\\\", type: v.type,\\n    severity: CONFIG.severity[v.type], track_id: v.track_id, confidence: v.conf,\\n    bbox: v.bbox || [], snapshot_id: v.snapshot_id || \\\"\\\", via: \\\"cira\\\"\\n  };\\n}\\n\\n// A real violation: has conf (not a stale event, which carries event_id / confidence from the JS->AutoRun->MqttSub loop).\\nfunction isViolation(x) {\\n  return !!x && typeof x === \\\"object\\\" && !x.hasOwnProperty(\\\"event_id\\\") &&\\n         typeof x.camera_id === \\\"string\\\" && typeof x.type === \\\"string\\\" &&\\n         typeof x.track_id === \\\"number\\\" && typeof x.conf === \\\"number\\\";\\n}\\nfunction endsWithDsViolation(k) {\\n  var suf = \\\"/ds/violation\\\";\\n  return k.length >= suf.length && k.substring(k.length - suf.length) === suf;\\n}\\n// CiRA MqttSub wraps the new message as { \\\"<subscribed topic>\\\": <parsed payload> }. The loop leaves the previous\\n// event at the top level, so look under a \\\".../ds/violation\\\" key first, then other keys, then p itself last.\\nfunction findViolation(p) {\\n  var c = [];\\n  if (p && typeof p === \\\"object\\\") {\\n    for (var k in p) if (p.hasOwnProperty(k) && endsWithDsViolation(k)) c.push(p[k]);\\n    for (var k2 in p) if (p.hasOwnProperty(k2) && !endsWithDsViolation(k2)) c.push(p[k2]);\\n  }\\n  c.push(p);\\n  for (var j = 0; j < c.length; j++) {\\n    var x = c[j];\\n    if (typeof x === \\\"string\\\") { try { x = JSON.parse(x); } catch (e) { continue; } }\\n    if (isViolation(x)) return x;\\n  }\\n  return null;\\n}\\n\\nfunction loadState() {\\n  var s = null;\\n  if (hasGlobal(\\\"decide_state\\\")) s = getGlobal(\\\"decide_state\\\");\\n  if (typeof s === \\\"string\\\") { try { s = JSON.parse(s); } catch (e) { s = null; } }\\n  if (!s || typeof s !== \\\"object\\\") s = { lastSent: {}, received: 0, published: 0, filtered: 0, last_rx: \\\"\\\" };\\n  return s;\\n}\\n\\nfunction clearObject(o) { for (var k in o) if (o.hasOwnProperty(k)) delete o[k]; }\\n\\nvar stage = \\\"start\\\";\\ntry {\\n  var now = Date.now();\\n  stage = \\\"load_state\\\"; var st = loadState();\\n  st.received = st.received + 1;\\n  st.last_rx = isoBkk(now);\\n  stage = \\\"find\\\"; var v = findViolation(payload);\\n  stage = \\\"decide\\\"; var ev = decide(v, st.lastSent, now);\\n  if (ev) st.published = st.published + 1; else st.filtered = st.filtered + 1;\\n  stage = \\\"save_state\\\";\\n  for (var ck in st.lastSent) {\\n    if (st.lastSent.hasOwnProperty(ck) && now - st.lastSent[ck] > CONFIG.cooldownS * 1000) delete st.lastSent[ck];\\n  }\\n  setGlobal(\\\"decide_state\\\", JSON.stringify(st));\\n  if (DEBUG) print((ev ? \\\"EVENT \\\" + ev.event_id : \\\"filtered\\\") +\\n                   \\\"  rx=\\\" + st.received + \\\" pub=\\\" + st.published + \\\" filt=\\\" + st.filtered + \\\"\\\\n\\\");\\n  stage = \\\"write_payload\\\";\\n  clearObject(payload);\\n  if (ev) {\\n    for (var f in ev) if (ev.hasOwnProperty(f)) payload[f] = ev[f];\\n  } else {\\n    payload.cira_drop = true;\\n  }\\n} catch (e) {\\n  clearObject(payload);\\n  payload.cira_drop = true;\\n  print(\\\"ERROR decide: \\\" + e + \\\" line=\\\" + e.lineNumber + \\\" stage=\\\" + stage + \\\"\\\\n\\\");\\n}\\n\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        }\n                    }\n                },\n                \"name\": \"JavaScript\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 34,\n                \"y\": 153\n            }\n        },\n        {\n            \"id\": \"{e272839b-6c5b-4818-9321-c666573f0214}\",\n            \"model\": {\n                \"name\": \"AutoRun\",\n                \"node_enable\": false\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -493,\n                \"y\": 476\n            }\n        },\n        {\n            \"id\": \"{6eb6afbe-b641-4484-8539-a96b217604ac}\",\n            \"model\": {\n                \"mqtt_pub\": {\n                    \"cert_file\": \"-\",\n                    \"host\": \"127.0.0.1\",\n                    \"is_use_cert\": false,\n                    \"is_use_ssl\": false,\n                    \"pass\": \"\",\n                    \"port\": 1883,\n                    \"qos\": 1,\n                    \"send_img\": false,\n                    \"topic\": \"factory/safety/cira/status\",\n                    \"user\": \"\"\n                },\n                \"name\": \"MqttPub\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": -34,\n                \"y\": 459\n            }\n        }\n    ],\n    \"scene_data\": {\n        \"flow_view_fix\": false,\n        \"flow_view_pos_x\": -632.4143228790215,\n        \"flow_view_pos_y\": -82.50278433216951,\n        \"flow_view_zoom_factor\": 0.5836907815769232,\n        \"scene_version\": 1\n    }\n}\n",
